{
  "name": "kettermean",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Liminal first-person dream walker inspired by LSD: Dream Emulator, with optional LLM-generated rooms.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:models": "vitest run tests/modelAudit.test.ts --reporter=verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "eslint": "^10.8.1",
    "globals": "^16.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  }
}
